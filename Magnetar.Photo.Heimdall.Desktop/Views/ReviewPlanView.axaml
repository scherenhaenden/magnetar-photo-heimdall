<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Magnetar.Photo.Heimdall.Desktop.ViewModels.PlanReview"
             x:DataType="vm:ReviewPlanViewModel"
             x:Class="Magnetar.Photo.Heimdall.Desktop.Views.ReviewPlanView"
             MinWidth="840" MinHeight="520" Background="#051424" Foreground="#D4E4FA"
             FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Review plan" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Read-only view of planned operations." Foreground="#BAC9CC"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <!-- Loading State -->
      <StackPanel IsVisible="{Binding IsLoading}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#00E5FF"/>
        <TextBlock Text="Loading plan operations..." Foreground="#BAC9CC" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Empty State -->
      <TextBlock IsVisible="{Binding IsEmpty}" Text="No operations planned." Foreground="#BAC9CC" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>

      <!-- Unloaded State -->
      <TextBlock IsVisible="{Binding IsUnloaded}" Text="No plan loaded." Foreground="#BAC9CC" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>

      <!-- Error State -->
      <Border IsVisible="{Binding HasError}" Background="#33FF2222" BorderBrush="#FF2222" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="8">
          <TextBlock Text="⚠ Error loading plan" FontWeight="Bold" Foreground="#FFB4AB"/>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Loaded State -->
      <Border IsVisible="{Binding IsLoaded}" Background="#122131" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#1C2B3C" Padding="12,10">
            <Grid ColumnDefinitions="120,2*,2*,150">
              <TextBlock Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/>
              <TextBlock Grid.Column="1" Text="SOURCE" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/>
              <TextBlock Grid.Column="2" Text="DESTINATION" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/>
              <TextBlock Grid.Column="3" Text="WARNING" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Operations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="12,11" BorderBrush="#1C2B3C" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="120,2*,2*,150">
                      <TextBlock Text="{Binding Action}" Foreground="#00E5FF" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11" Margin="0,0,10,0" ToolTip.Tip="{Binding Source}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11" Margin="0,0,10,0" ToolTip.Tip="{Binding Destination}"/>
                      <TextBlock Grid.Column="3" Text="{Binding Warning}" Foreground="#FFB4AB" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Warning}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#273647" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8" Padding="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="ⓘ" Foreground="#00DAF3" FontSize="20"/>
        <TextBlock Text="Read-only mode. Operations must be approved externally." TextWrapping="Wrap" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
