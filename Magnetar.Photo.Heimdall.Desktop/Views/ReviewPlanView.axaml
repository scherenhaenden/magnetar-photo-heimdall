<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Magnetar.Photo.Heimdall.Desktop.Views.ReviewPlanView"
             MinWidth="840" MinHeight="520" Background="#051424" Foreground="#D4E4FA"
             FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter">
  <!-- Presentation-only: this screen exposes the safety model but cannot approve or alter files. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4"><TextBlock Text="Revisar plan" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Verificación final antes de ejecutar operaciones." Foreground="#BAC9CC"/><TextBlock Text="PRESENTACIÓN · plan y operaciones pendientes de backend" FontSize="10" FontWeight="Bold" Foreground="#00DAF3" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom"><Button Content="Nombres" IsEnabled="False"/><Button Content="Espacio" IsEnabled="False"/><Button Content="Permisos" IsEnabled="False"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="3*,*" ColumnSpacing="14">
      <Border Background="#122131" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#1C2B3C" Padding="12,10"><Grid ColumnDefinitions="32,100,2*,2*,70,62,72,120"><TextBlock Text="✓"/><TextBlock Grid.Column="1" Text="ACCIÓN" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="2" Text="ORIGEN" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="3" Text="DESTINO" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="4" Text="TAMAÑO" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="5" Text="HASH" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="6" Text="CONFLICTO" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock Grid.Column="7" Text="RAZÓN / ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/></Grid></Border>
          <StackPanel Grid.Row="1">
            <Border Background="#122131" Padding="12,11"><Grid ColumnDefinitions="32,100,2*,2*,70,62,72,120"><CheckBox IsChecked="True" IsEnabled="False"/><TextBlock Grid.Column="1" Text="▣  Copiar" Foreground="#00E5FF"/><TextBlock Grid.Column="2" Text="/vol/raw/…IMG_01.CR2" TextTrimming="CharacterEllipsis" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="3" Text="/nas/arch/…IMG_01.CR2" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="4" Text="32,4 MB" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="5" Text="● OK" Foreground="#00E5FF" FontSize="11"/><TextBlock Grid.Column="6" Text="—" Foreground="#BAC9CC"/><StackPanel Grid.Column="7"><TextBlock Text="Coincide regla" FontSize="11"/><TextBlock Text="SSH: NAS-Alpha" FontSize="10" Foreground="#00DAF3"/></StackPanel></Grid></Border>
            <Border Background="#0D1C2D" Padding="12,11"><Grid ColumnDefinitions="32,100,2*,2*,70,62,72,120"><CheckBox IsChecked="True" IsEnabled="False"/><TextBlock Grid.Column="1" Text="◇  Mover seguro" Foreground="#FFB4AB" FontSize="11"/><TextBlock Grid.Column="2" Text="/vol/work/…VID_99.MP4" TextTrimming="CharacterEllipsis" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="3" Text="/nas/cold/…VID_99.MP4" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="4" Text="1,2 GB" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="5" Text="● OK" Foreground="#00E5FF" FontSize="11"/><TextBlock Grid.Column="6" Text="—" Foreground="#BAC9CC"/><StackPanel Grid.Column="7"><TextBlock Text="Antigüedad &gt; 365d" FontSize="11"/><TextBlock Text="Local" FontSize="10" Foreground="#00DAF3"/></StackPanel></Grid></Border>
            <Border Padding="12,11" Opacity="0.58"><Grid ColumnDefinitions="32,100,2*,2*,70,62,72,120"><CheckBox IsEnabled="False"/><TextBlock Grid.Column="1" Text="⊘  No-op" Foreground="#BAC9CC"/><TextBlock Grid.Column="2" Text="/vol/raw/…IMG_02.CR2" TextTrimming="CharacterEllipsis" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="3" Text="/nas/arch/…IMG_02.CR2" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="4" Text="31,1 MB" Foreground="#BAC9CC" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="5" Text="Saltar" Foreground="#BAC9CC" FontSize="11"/><TextBlock Grid.Column="6" Text="⚠ Existe" Foreground="#FFB4AB" FontSize="11"/><StackPanel Grid.Column="7"><TextBlock Text="Coincidencia exacta" FontSize="11"/><TextBlock Text="SSH: NAS-Alpha" FontSize="10" Foreground="#BAC9CC"/></StackPanel></Grid></Border>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Spacing="12">
        <Border Background="#0D1C2D" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="12"><TextBlock Text="▣  ESPACIO REQUERIDO" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="NAS-Alpha (SSH)"/><TextBlock Grid.Column="1" Text="1,4 TB" Foreground="#00E5FF" FontFamily="Consolas"/></Grid><ProgressBar Value="65" Maximum="100" Height="5" Foreground="#00E5FF"/><TextBlock Text="4,2 TB libres" FontSize="10" Foreground="#BAC9CC" HorizontalAlignment="Right"/></StackPanel><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cold storage (local)"/><TextBlock Grid.Column="1" Text="850 GB" Foreground="#00DAF3" FontFamily="Consolas"/></Grid><ProgressBar Value="30" Maximum="100" Height="5" Foreground="#00DAF3"/><TextBlock Text="8,1 TB libres" FontSize="10" Foreground="#BAC9CC" HorizontalAlignment="Right"/></StackPanel></StackPanel></Border>
        <Border Background="#122131" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel Spacing="12"><TextBlock Text="◉  CUARENTENA" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><TextBlock><Run Text="12" FontSize="28"/><Run Text=" archivos aislados" Foreground="#BAC9CC" FontSize="12"/></TextBlock><TextBlock Text="♨  ESTADO TÉRMICO" FontSize="10" FontWeight="Bold" Foreground="#BAC9CC"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="NODE-1 · carga reducida" FontSize="11"/><TextBlock Grid.Column="1" Text="78 °C" Foreground="#FFB4AB" FontFamily="Consolas" FontSize="11"/></Grid><ProgressBar Value="82" Maximum="100" Height="5" Foreground="#FFB4AB"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="NAS-A · normal" FontSize="11"/><TextBlock Grid.Column="1" Text="42 °C" Foreground="#00E5FF" FontFamily="Consolas" FontSize="11"/></Grid><ProgressBar Value="40" Maximum="100" Height="5" Foreground="#00E5FF"/></StackPanel></Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="#273647" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="8" Padding="14"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="ⓘ" Foreground="#00DAF3" FontSize="20"/><TextBlock Text="Resumen de seguridad: no se eliminará ningún archivo permanentemente. La aprobación, copia, verificación, cuarentena y journal requieren backend." TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Content="Aprobar y ejecutar 4.821 operaciones · backend pendiente" IsEnabled="False" Background="#00E5FF" Foreground="#00363D"/></Grid></Border>
  </Grid>
</UserControl>
