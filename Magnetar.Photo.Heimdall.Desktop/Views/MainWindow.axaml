<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Magnetar.Photo.Heimdall.Desktop.Controls"
        xmlns:views="clr-namespace:Magnetar.Photo.Heimdall.Desktop.Views"
        x:Class="Magnetar.Photo.Heimdall.Desktop.Views.MainWindow"
        Width="1180" Height="760" MinWidth="920" MinHeight="580"
        Title="Heimdall — Remote Photo Duplicates">
  <controls:HeimdallShell Theme="{StaticResource HeimdallShell}">
    <views:LibrariesView />
  </controls:HeimdallShell>
</Window>
