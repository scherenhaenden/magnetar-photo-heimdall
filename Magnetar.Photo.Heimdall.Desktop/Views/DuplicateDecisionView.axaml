<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Magnetar.Photo.Heimdall.Desktop.ViewModels.DuplicateDecision"
             x:Class="Magnetar.Photo.Heimdall.Desktop.Views.DuplicateDecisionView"
             x:DataType="vm:DuplicateDecisionViewModel"
             MinWidth="920" MinHeight="580">
  <UserControl.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#91A5B0" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Border.group"><Setter Property="Background" Value="#0D1C2D" /><Setter Property="BorderBrush" Value="#263B4B" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="12" /></Style>
    <Style Selector="Border.group:pointerover"><Setter Property="Background" Value="#122C39" /></Style>

    <Style Selector="Border.asset"><Setter Property="Background" Value="#081421" /><Setter Property="BorderBrush" Value="#3B494C" /></Style>
    <Style Selector="Border.asset.keeper"><Setter Property="Background" Value="#051424" /><Setter Property="BorderBrush" Value="#00DAF3" /></Style>
  </UserControl.Styles>

  <Grid Background="#051424" RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="#0D1C2D" BorderBrush="#263B4B" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Decisión de duplicados" FontSize="25" FontWeight="SemiBold" Foreground="#D4E4FA" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Bibliotecas › Archivo ›" Foreground="#91A5B0" />
            <TextBlock Text="Duplicados" Foreground="#00DAF3" />
            <Border Background="#173B47" CornerRadius="4" Padding="7,2">
              <TextBlock Text="VISTA PREVIA · sin decisiones persistidas" FontSize="10" FontWeight="Bold" Foreground="#9CF0FF" />
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Crear plan de limpieza" IsEnabled="{Binding AllGroupsResolved}" ToolTip.Tip="Requiere que todos los grupos tengan un keeper seleccionado." />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#0A1A2A" Padding="24,15" BorderBrush="#263B4B" BorderThickness="0,0,0,1" IsVisible="{Binding HasData}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#D4E4FA">
            <Run Text="{Binding TotalGroupsCount}" />
            <Run Text="grupos críticos identificados" />
          </TextBlock>
          <TextBlock FontSize="12" Foreground="#FFCE8A" Margin="0,3,0,0">
            <Run Text="Ahorro potencial:" />
            <Run Text="{Binding TotalPotentialSavingsBytes}" />
            <Run Text="bytes · ninguna acción de archivo se ejecutará desde esta vista" />
          </TextBlock>
        </StackPanel>
        <Border Grid.Column="1" Background="#122C39" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="label" Text="CONFIANZA" />
            <TextBlock Classes="mono" Text="&gt; 99.9% HASH" Foreground="#9CF0FF" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="2" IsVisible="{Binding IsLoading}">
      <TextBlock Text="Cargando duplicados..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#91A5B0" />
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFB4AB" />
    </Grid>

    <Grid Grid.Row="2" IsVisible="{Binding IsEmpty}">
      <TextBlock Text="No se encontraron duplicados." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#91A5B0" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="270,*" Margin="20" ColumnSpacing="14" IsVisible="{Binding HasData}">
      <!-- Groups List -->
      <Border Background="#122131" BorderBrush="#263B4B" BorderThickness="1" CornerRadius="7">
        <Grid RowDefinitions="42,*">
          <Border Background="#1C2B3C" Padding="12,0" CornerRadius="7,7,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="GRUPOS VERIFICADOS" Classes="label" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#173B47" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalGroupsCount}" Classes="mono" Foreground="#9CF0FF" />
              </Border>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                <Border Classes="group" Classes.resolved="{Binding IsResolved}">
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding RepresentativeFileName}" Classes="mono" Foreground="#BAC9CC" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="label" Foreground="#BCC7DE">
                        <Run Text="{Binding Assets.Count}" />
                        <Run Text="COPIAS" />
                      </TextBlock>
                    </Grid>
                    <TextBlock Classes="mono" Foreground="#91A5B0">
                      <Run Text="Ahorro:" />
                      <Run Text="{Binding PotentialSavingsBytes}" />
                      <Run Text="bytes" />
                    </TextBlock>
                    <TextBlock Text="✓ RESUELTO" Classes="label" Foreground="#00DAF3" IsVisible="{Binding IsResolved}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Selected Group Details -->
      <Border Grid.Column="1" Background="#122131" BorderBrush="#263B4B" BorderThickness="1" CornerRadius="7">
        <Grid RowDefinitions="48,*">
          <Border Background="#1C2B3C" Padding="14,0" CornerRadius="7,7,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" DataContext="{Binding SelectedGroup}">
                <TextBlock Text="ANÁLISIS PIXEL-PERFECT" Classes="label" />
                <TextBlock Text="{Binding Algorithm, StringFormat='✓ IDENTIDAD {0} CONFIRMADA'}" Classes="mono" Foreground="#9CF0FF" IsVisible="{Binding Algorithm, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" Padding="16" DataContext="{Binding SelectedGroup}">
            <StackPanel IsVisible="{Binding $parent[ScrollViewer].DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="Decisión propuesta · selecciona exactamente un keeper" FontSize="12" Foreground="#91A5B0" Margin="0,0,0,12" />
              <ItemsControl ItemsSource="{Binding Assets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="290" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DuplicateAssetViewModel">
                    <Border Width="276" Margin="0,0,14,14" Classes="asset" Classes.keeper="{Binding IsKeeper}" BorderThickness="1" CornerRadius="6">
                      <Grid RowDefinitions="Auto,*">
                        <Grid Background="#263B4B" Height="60">
                           <TextBlock Text="◒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" Foreground="#BAC9CC" />
                           <Border IsVisible="{Binding IsKeeper}" Background="#07121E" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                             <TextBlock Text="★ KEEPER" Classes="label" Foreground="#9CF0FF" />
                           </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="12" Spacing="8">
                          <TextBlock Classes="label" Text="RUTA" />
                          <TextBlock Classes="mono" Text="{Binding FilePath}" TextWrapping="Wrap" Foreground="#D4E4FA" />

                          <TextBlock Classes="label" Text="TAMAÑO" />
                          <TextBlock Classes="mono" Foreground="#D4E4FA">
                            <Run Text="{Binding SizeInBytes}" />
                            <Run Text="bytes" />
                          </TextBlock>

                          <Border Height="1" Background="#263B4B" />

                          <TextBlock Classes="label" Text="HASH" />
                          <TextBlock Classes="mono" Text="{Binding Hash}" Foreground="#BAC9CC" TextTrimming="CharacterEllipsis" />

                          <RadioButton IsChecked="{Binding IsKeeper, Mode=TwoWay}" GroupName="{ReflectionBinding $parent[ItemsControl].DataContext.GroupId}" Content="Conservar este archivo" Foreground="#D4E4FA" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
