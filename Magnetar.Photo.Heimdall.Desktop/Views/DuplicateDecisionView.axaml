<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Magnetar.Photo.Heimdall.Desktop.Views.DuplicateDecisionView"
             MinWidth="920" MinHeight="580">
  <!-- Presentation-only composition. Every action deliberately stops before file mutation. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#91A5B0" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Border.group"><Setter Property="Background" Value="#0D1C2D" /><Setter Property="BorderBrush" Value="#263B4B" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="12" /></Style>
  </UserControl.Styles>
  <Grid Background="#051424" RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="#0D1C2D" BorderBrush="#263B4B" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="Decisión de duplicados" FontSize="25" FontWeight="SemiBold" Foreground="#D4E4FA" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Bibliotecas › Archivo 2020 ›" Foreground="#91A5B0" /><TextBlock Text="Duplicados" Foreground="#00DAF3" /><Border Background="#173B47" CornerRadius="4" Padding="7,2"><TextBlock Text="VISTA PREVIA · sin decisiones persistidas" FontSize="10" FontWeight="Bold" Foreground="#9CF0FF" /></Border></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBox Width="190" Watermark="Buscar duplicados…" /><Button Content="Crear plan de limpieza" IsEnabled="False" ToolTip.Tip="Requiere un grupo real y una decisión revisada." /></StackPanel></Grid>
    </Border>
    <Border Grid.Row="1" Background="#0A1A2A" Padding="24,15" BorderBrush="#263B4B" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="14 grupos críticos identificados" FontSize="18" FontWeight="SemiBold" Foreground="#D4E4FA" /><TextBlock Text="Ahorro potencial: 12.4 GB · ninguna acción de archivo se ejecutará desde esta vista" FontSize="12" Foreground="#FFCE8A" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Background="#122C39" CornerRadius="4" Padding="10,5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="label" Text="CONFIANZA" /><TextBlock Classes="mono" Text="&gt; 99.9% BLAKE3" Foreground="#9CF0FF" /></StackPanel></Border></Grid></Border>
    <Grid Grid.Row="2" ColumnDefinitions="270,*" Margin="20" ColumnSpacing="14">
      <Border Background="#122131" BorderBrush="#263B4B" BorderThickness="1" CornerRadius="7"><Grid RowDefinitions="42,*"><Border Background="#1C2B3C" Padding="12,0" CornerRadius="7,7,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="GRUPOS VERIFICADOS" Classes="label" VerticalAlignment="Center" /><Border Grid.Column="1" Background="#173B47" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"><TextBlock Text="14" Classes="mono" Foreground="#9CF0FF" /></Border></Grid></Border><ScrollViewer Grid.Row="1" Padding="8"><StackPanel Spacing="8"><Border Classes="group" BorderBrush="#00DAF3"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="DSC_0894_FINAL.ARW" Classes="mono" Foreground="#D4E4FA" /><Border Grid.Column="1" Background="#47212A" CornerRadius="3" Padding="5,2"><TextBlock Text="3 COPIAS" Classes="label" Foreground="#FFB4AB" /></Border></Grid><Grid ColumnDefinitions="52,*" ColumnSpacing="9"><Border Background="#24586A" Height="52" CornerRadius="4"><TextBlock Text="◒" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CF0FF" FontSize="25" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Ahorro: 84.2 MB" Classes="mono" Foreground="#BAC9CC" /><ProgressBar Value="99" Maximum="100" Height="4" Foreground="#00DAF3" /></StackPanel></Grid></StackPanel></Border><Border Classes="group"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="IMG_9021_EDIT.TIF" Classes="mono" Foreground="#BAC9CC" /><TextBlock Grid.Column="1" Text="2 COPIAS" Classes="label" Foreground="#BCC7DE" /></Grid><TextBlock Text="Ahorro: 142.1 MB" Classes="mono" Foreground="#91A5B0" /></StackPanel></Border><Border Classes="group"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="PROJ_NORDIC_01.DNG" Classes="mono" Foreground="#BAC9CC" /><TextBlock Grid.Column="1" Text="4 COPIAS" Classes="label" Foreground="#FFB4AB" /></Grid><TextBlock Text="Ahorro: 210.5 MB" Classes="mono" Foreground="#91A5B0" /></StackPanel></Border></StackPanel></ScrollViewer></Grid></Border>
      <Border Grid.Column="1" Background="#122131" BorderBrush="#263B4B" BorderThickness="1" CornerRadius="7"><Grid RowDefinitions="48,*"><Border Background="#1C2B3C" Padding="14,0" CornerRadius="7,7,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="ANÁLISIS PIXEL-PERFECT" Classes="label" /><TextBlock Text="✓ IDENTIDAD BLAKE3 CONFIRMADA" Classes="mono" Foreground="#9CF0FF" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Excluir grupo" IsEnabled="False" /><Button Content="Crear plan reversible" IsEnabled="False" /></StackPanel></Grid></Border><ScrollViewer Grid.Row="1" Padding="16"><StackPanel><TextBlock Text="Decisión propuesta · revisa las copias antes de crear un plan" FontSize="12" Foreground="#91A5B0" Margin="0,0,0,12" /><WrapPanel ItemWidth="290" ItemHeight="360"><Border Width="276" Height="344" Margin="0,0,14,14" Background="#051424" BorderBrush="#00DAF3" BorderThickness="1" CornerRadius="6"><Grid RowDefinitions="115,*"><Grid Background="#24586A"><TextBlock Text="◒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="55" Foreground="#9CF0FF" /><Border Background="#07121E" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="★ KEEPER SUGERIDO" Classes="label" Foreground="#9CF0FF" /></Border></Grid><StackPanel Grid.Row="1" Margin="12" Spacing="8"><TextBlock Classes="label" Text="RUTA" /><TextBlock Classes="mono" Text="/Volumes/NAS_Arch/2020/RAW/DSC_0894_FINAL.ARW" TextWrapping="Wrap" Foreground="#D4E4FA" /><Grid ColumnDefinitions="*,*"><StackPanel><TextBlock Classes="label" Text="RESOLUCIÓN" /><TextBlock Classes="mono" Text="8256 × 5504" Foreground="#D4E4FA" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="label" Text="TAMAÑO" /><TextBlock Classes="mono" Text="42.1 MB" Foreground="#D4E4FA" /></StackPanel></Grid><Border Height="1" Background="#263B4B" /><TextBlock Classes="label" Text="HASH BLAKE3" /><TextBlock Classes="mono" Text="af1349b9…b93220" Foreground="#9CF0FF" /><CheckBox IsChecked="True" Content="Conservar este archivo" Foreground="#D4E4FA" IsEnabled="False" /></StackPanel></Grid></Border><Border Width="276" Height="344" Margin="0,0,14,14" Background="#081421" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="6"><Grid RowDefinitions="115,*"><Grid Background="#244554"><TextBlock Text="◒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="55" Foreground="#BAC9CC" /><Border Background="#47212A" CornerRadius="3" Padding="7,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="ENVIAR A CUARENTENA" Classes="label" Foreground="#FFB4AB" /></Border></Grid><StackPanel Grid.Row="1" Margin="12" Spacing="8"><TextBlock Classes="label" Text="RUTA" /><TextBlock Classes="mono" Text="/Users/admin/Downloads/DSC_0894_FINAL_copy.ARW" TextWrapping="Wrap" Foreground="#FFB4AB" /><Grid ColumnDefinitions="*,*"><StackPanel><TextBlock Classes="label" Text="RESOLUCIÓN" /><TextBlock Classes="mono" Text="8256 × 5504" Foreground="#D4E4FA" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="label" Text="TAMAÑO" /><TextBlock Classes="mono" Text="42.1 MB" Foreground="#D4E4FA" /></StackPanel></Grid><Border Height="1" Background="#263B4B" /><TextBlock Classes="label" Text="HASH BLAKE3" /><TextBlock Classes="mono" Text="af1349b9…b93220" Foreground="#BAC9CC" /><CheckBox Content="Conservar este archivo" Foreground="#BAC9CC" IsEnabled="False" /></StackPanel></Grid></Border><Border Width="276" Height="344" Margin="0,0,14,14" Background="#081421" BorderBrush="#3B494C" BorderThickness="1" CornerRadius="6"><Grid RowDefinitions="115,*"><Grid Background="#263B4B"><TextBlock Text="◒" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="55" Foreground="#BAC9CC" /></Grid><StackPanel Grid.Row="1" Margin="12" Spacing="8"><TextBlock Classes="label" Text="RUTA" /><TextBlock Classes="mono" Text="/Volumes/Backup_Drive_A/2020_dump/DSC_0894_FINAL.ARW" TextWrapping="Wrap" Foreground="#FFB4AB" /><Grid ColumnDefinitions="*,*"><StackPanel><TextBlock Classes="label" Text="RESOLUCIÓN" /><TextBlock Classes="mono" Text="8256 × 5504" Foreground="#D4E4FA" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="label" Text="TAMAÑO" /><TextBlock Classes="mono" Text="42.1 MB" Foreground="#D4E4FA" /></StackPanel></Grid><Border Height="1" Background="#263B4B" /><TextBlock Classes="label" Text="HASH BLAKE3" /><TextBlock Classes="mono" Text="af1349b9…b93220" Foreground="#BAC9CC" /><CheckBox Content="Conservar este archivo" Foreground="#BAC9CC" IsEnabled="False" /></StackPanel></Grid></Border></WrapPanel></StackPanel></ScrollViewer></Grid></Border>
    </Grid>
  </Grid>
</UserControl>
